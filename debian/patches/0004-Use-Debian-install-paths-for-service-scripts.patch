Description: Use Debian install paths for service and test scripts
 The package installs executable scripts below /usr/share/ub-pkg-manager,
 so systemd units and test commands must not refer to /usr/local.
Author: zhangxinghao <zhangxinghao@kunlunit.com>
Forwarded: no
Last-Update: 2026-09-20

Index: src-openEuler-ub-pkg-manager/ub-pkg-manager.service
===================================================================
--- src-openEuler-ub-pkg-manager.orig/ub-pkg-manager.service
+++ src-openEuler-ub-pkg-manager/ub-pkg-manager.service
@@ -5,7 +5,7 @@ Requires=ub-pkg-urma.service ub-pkg-mem.
 
 [Service]
 Type=oneshot
-ExecStart=/usr/local/ub-pkg-manager/bin/00-ub-pkg-manager.sh
+ExecStart=/usr/share/ub-pkg-manager/bin/04-ub-pkg-manager.sh
 StandardOutput=journal
 StandardError=journal
 RemainAfterExit=yes
