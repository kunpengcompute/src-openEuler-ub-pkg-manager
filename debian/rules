#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_BUILD_OPTIONS = nocheck
export PYBUILD_NAME = ub_manage
export PYBUILD_SYSTEM = distutils

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install

	# Copy pybuild output to debian/tmp for consistent install file handling
	mkdir -p debian/tmp
	if [ -d debian/python3-ub-manage ]; then \
		cp -a debian/python3-ub-manage/* debian/tmp/ ; \
	fi

	# Remove __pycache__ directories
	find $(CURDIR)/debian/tmp -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

	# Create necessary directories
	mkdir -p debian/tmp/usr/lib/systemd/system
	mkdir -p debian/tmp/etc/ub-pkg-manager
	mkdir -p debian/tmp/usr/share/ub-pkg-manager/bin
	mkdir -p debian/tmp/usr/share/ub-pkg-manager

	# Install systemd service files
	install -m 644 ub-pkg-manager.service debian/tmp/usr/lib/systemd/system/
	install -m 644 ub-pkg-urma.service debian/tmp/usr/lib/systemd/system/
	install -m 644 ub-pkg-mem.service debian/tmp/usr/lib/systemd/system/
	install -m 644 ub-pkg-virt.service debian/tmp/usr/lib/systemd/system/

	# Install configuration files
	install -m 644 src/ub_manage/etc/check.yml debian/tmp/etc/ub-pkg-manager/

	# Install scripts
	install -m 755 src/ub_manage/scripts/00-ub-pkg-devm.sh debian/tmp/usr/share/ub-pkg-manager/bin/
	install -m 755 src/ub_manage/scripts/01-ub-pkg-urma.sh debian/tmp/usr/share/ub-pkg-manager/bin/
	install -m 755 src/ub_manage/scripts/02-ub-pkg-mem.sh debian/tmp/usr/share/ub-pkg-manager/bin/
	install -m 755 src/ub_manage/scripts/03-ub-pkg-virt.sh debian/tmp/usr/share/ub-pkg-manager/bin/
	install -m 755 src/ub_manage/scripts/04-ub-pkg-manager.sh debian/tmp/usr/share/ub-pkg-manager/bin/

	# Install testkit
	mkdir -p debian/tmp/usr/share/ub-pkg-manager/bin/testkit
	cp -r src/ub_manage/scripts/testkit/* debian/tmp/usr/share/ub-pkg-manager/bin/testkit/
	# Fix permissions - remove execute bit from C source files
	find debian/tmp/usr/share/ub-pkg-manager/bin/testkit -name "*.c" -exec chmod 644 {} +
	find debian/tmp/usr/share/ub-pkg-manager/bin/testkit -name "*.sh" -exec chmod 755 {} +

override_dh_auto_test:
	# Skip tests during package build
	@echo "Skipping tests"
